# Copy to .env and fill in. Never commit the real .env.
DB_URL=mongodb://localhost:27017/ecomdb
# Generate a strong value, e.g.  openssl rand -hex 48
JWT_SECRET=replace-with-a-long-random-secret
# comma-separated list of browser origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000
# Hosted/production seed wipes the catalog. Required only for that one-shot:
#   SEED_CONFIRM=1 npm run seed
# Do not leave this set on the running app.
